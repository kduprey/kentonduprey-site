{
  "name": "@kduprey/db",
  "version": "1.0.0",
  "private": "true",
  "author": "Kenton Duprey",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "prisma migrate deploy && pnpm generate",
    "predev": "pnpm generate",
    "dev": "tsup src/* --watch",
    "format": "prisma format",
    "generate": "prisma generate",
    "check": "pnpx ultracite@latest check",
    "fix": "pnpx ultracite@latest fix",
    "migrate": "prisma migrate dev",
    "push": "prisma db push --skip-generate",
    "seed": "prisma db seed",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "7.0.1"
  },
  "devDependencies": {
    "@kduprey/tsconfig": "workspace:*",
    "@types/node": "^24.10.1",
    "prisma": "^7.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma"
  }
}
