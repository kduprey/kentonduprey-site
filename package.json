{
  "name": "@kduprey/apps",
  "version": "1.0.0",
  "keywords": [],
  "author": "Kenton Duprey",
  "scripts": {
    "build": "pnpm dlx turbo build",
    "build:local": "pnpm start:db:local && dotenv -- pnpm dlx turbo build && pnpm stop:db:local",
    "predev": "pnpm start:db:local",
    "dev": "dotenv -- concurrently 'pnpm dlx turbo dev' 'pnpm stripe:listen'",
    "postdev": "pnpm stop:db:local",
    "lint": "pnpm dlx turbo lint",
    "migration": "pnpm --filter @kduprey/cms migration",
    "migration:create": "pnpm --filter @kduprey/cms migration:create",
    "migration:live": "pnpm --filter @kduprey/cms migration:live",
    "migration:prod": "pnpm --filter @kduprey/cms migration:prod",
    "migration:live:prod": "pnpm --filter @kduprey/cms migration:live:prod",
    "publishContent": "pnpm --filter @kduprey/cms publishContent",
    "pullContent": "pnpm --filter @kduprey/cms pullContent",
    "start": "pnpm dlx turbo start",
    "start:db:local": "docker-compose up -d && dotenv -- pnpm --filter @kduprey/db migrate",
    "stop:db:local": "docker-compose down",
    "stripe:listen": "stripe listen -f $STRIPE_WEBHOOK_FW_URL -a",
    "test": "echo \"Error: no test specified\" && exit 1",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "concurrently": "^10.0.6",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv-cli": "^11.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.90.0",
    "release-please": "^17.11.2",
    "turbo": "^2.11.10",
    "ultracite": "8.1.1"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [
        0
      ],
      "footer-max-line-length": [
        0
      ],
      "header-max-length": [
        0
      ],
      "subject-case": [
        0
      ]
    }
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog",
      "scopes": [
        "admin",
        "ci",
        "cms",
        "config",
        "db",
        "frontend",
        "tsconfig",
        "turbo",
        "ui",
        "utils"
      ]
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.17.0",
  "prisma": {
    "schema": "packages/db/prisma/schema.prisma"
  }
}
