{
  "name": "@kduprey/apps",
  "version": "1.0.0",
  "keywords": [],
  "author": "Kenton Duprey",
  "scripts": {
    "build": "turbo build",
    "build:local": "pnpm start:db:local && dotenv -- turbo build && pnpm stop:db:local",
    "predev": "pnpm start:db:local",
    "dev": "dotenv -- concurrently 'turbo dev' 'pnpm stripe:listen'",
    "postdev": "pnpm stop:db:local",
    "check": "turbo check",
    "fix": "turbo fix",
    "lint": "turbo lint",
    "publishContent": "pnpm --filter @kduprey/cms publishContent",
    "pullContent": "pnpm --filter @kduprey/cms pullContent",
    "start": "turbo start",
    "start:db:local": "docker-compose up -d && dotenv -- pnpm --filter @kduprey/db migrate",
    "stop:db:local": "docker-compose down",
    "stripe:listen": "stripe listen -f $STRIPE_WEBHOOK_FW_URL -a",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "turbo": "^2.6.1",
    "ultracite": "6.3.8"
  },
  "packageManager": "pnpm@10.24.0",
  "prisma": {
    "schema": "./packages/db/prisma/schema.prisma"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "@prisma/client",
      "@prisma/engines",
      "@sentry/cli",
      "core-js-pure",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
