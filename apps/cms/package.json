{
  "name": "@kduprey/cms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "analyze": "ANALYZE=true next build",
    "build": "next build",
    "dev": "next dev -p 3402",
    "check": "pnpx ultracite@latest check",
    "fix": "pnpx ultracite@latest fix",
    "publishContent": "sanity dataset export staging . --overwrite && sanity dataset import staging.tar.gz production --replace",
    "pullContent": "sanity dataset export production . --overwrite && sanity dataset import production.tar.gz staging --replace",
    "start": "next start",
    "test": "npm run check && npm run typecheck",
    "typecheck": "tsc --noEmit"
  },

  "dependencies": {
    "@kduprey/config": "workspace:*",
    "@kduprey/tsconfig": "workspace:*",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.0.1",
    "@sanity/vision": "^4.19.0",
    "next": "16.0.5",
    "next-sanity": "^11.6.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sanity-plugin-iframe-pane": "^4.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.7",
    "sanity": "^4.19.0",
    "styled-components": "^6.1.19",
    "typescript": "5.9.3"
  }
}
