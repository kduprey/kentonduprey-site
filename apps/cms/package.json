{
  "name": "@kduprey/cms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "analyze": "ANALYZE=true next build",
    "build": "next build",
    "dev": "next dev -p 3402",
    "lint": "ultracite check .",
    "lint:fix": "ultracite fix .",
    "publishContent": "sanity dataset export staging . --overwrite && sanity dataset import staging.tar.gz production --replace",
    "pullContent": "sanity dataset export production . --overwrite && sanity dataset import production.tar.gz staging --replace",
    "start": "next start",
    "test": "npm run lint && npm run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kduprey/config": "workspace:*",
    "@kduprey/tsconfig": "workspace:*",
    "@sanity/icons": "^5.1.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.5.0",
    "next": "16.2.10",
    "next-sanity": "^13.1.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.3.1",
    "@types/node": "^22.13.13",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "sanity": "^6.7.0",
    "styled-components": "^6.1.17",
    "typescript": "5.8.3"
  }
}
