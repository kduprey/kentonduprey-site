{
  "name": "@kduprey/cms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "analyze": "ANALYZE=true next build",
    "build": "next build",
    "dev": "next dev -p 3402",
    "lint": "ultracite check .",
    "lint:fix": "ultracite fix .",
    "migration": "node scripts/run-migrations.mjs --dataset staging --dry-run",
    "migration:create": "node scripts/create-migration.mjs",
    "migration:live": "node scripts/run-migrations.mjs --dataset staging",
    "migration:live:prod": "node scripts/run-migrations.mjs --dataset production",
    "migration:prod": "node scripts/run-migrations.mjs --dataset production --dry-run",
    "publishContent": "sanity dataset export staging . --overwrite && sanity dataset import staging.tar.gz production --replace",
    "pullContent": "sanity dataset export production . --overwrite && sanity dataset import production.tar.gz staging --replace",
    "start": "next start",
    "test": "npm run lint && npm run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kduprey/config": "workspace:*",
    "@kduprey/tsconfig": "workspace:*",
    "@sanity/icons": "^5.2.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.21.0",
    "@sentry/nextjs": "^11.10.0",
    "next": "16.4.5",
    "next-sanity": "^13.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.3",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sanity": "^6.21.0",
    "styled-components": "^6.6.0",
    "typescript": "7.0.2"
  }
}
